# Configuracion de la automatizacion de venta Mallplaza
# Copia este archivo como ".env" (en la misma carpeta) y completa los valores reales.
# El .env NUNCA se sube a GitHub.

# Credenciales del Portal Tiendas Mallplaza
MALL_EMAIL=tu_correo@ejemplo.com
MALL_PASSWORD=TU_CLAVE_AQUI

# Montos a cargar (por ahora fijos; luego saldran de Local Mall / DimangoToGo)
MALL_TRANSACCIONES=35
MALL_TOTAL=650000

# Opciones de ejecucion
MALL_HEADLESS=1   # 1 = sin ventana (servidor). Pon 0 para ver el navegador al probar.
MALL_DRY_RUN=0    # 1 = NO confirma (solo prueba el flujo sin enviar la venta)
MALL_FORCE=0      # 1 = sobrescribe aunque la fila de hoy ya tenga venta
